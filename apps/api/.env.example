# App
APP_NAME=SalesCoach AI API
DEBUG=false

# Supabase
SUPABASE_URL=https://TU_SUPABASE.supabase.co
SUPABASE_KEY=tu_supabase_anon_key
SUPABASE_SERVICE_KEY=tu_service_key

# Groq (reemplaza OpenAI)
